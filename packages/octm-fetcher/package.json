{
  "name": "@rosen-bridge/octm-fetcher",
  "version": "0.0.0",
  "private": "true",
  "description": "Fetch and parse Rosen Token Map boxes from the Ergo node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/minimum-fee-job.git",
    "directory": "./packages/octm-fetcher"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "test": "cross-env NODE_OPTIONS=\"--import tsx\" vitest",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  },
  "dependencies": {
    "@fleet-sdk/core": "^0.12.0",
    "@fleet-sdk/crypto": "^0.11.0",
    "@fleet-sdk/serializer": "^0.11.0",
    "@rosen-bridge/extended-tokens": "^0.1.4",
    "@rosen-clients/ergo-node": "^3.2.0"
  }
}
