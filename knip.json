{
  "$schema": "https://unpkg.com/knip/schema.json",
  "workspaces": {
    "packages/**": {
      "entry": ["lib/{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}"]
    },
    "services/*": {
      "entry": ["{lib,src,tests}/**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}"]
    }
  },
  "ignoreDependencies": ["ergo-lib-wasm-browser"]
}
