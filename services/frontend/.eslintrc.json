{
  "extends": ["next/core-web-vitals", "prettier"],
  "plugins": ["import"],
  "overrides": [
    {
      "files": ["**/*.{js,ts,jsx,tsx}"],
      "rules": {
        "import/order": [
          "error",
          {
            "groups": [
              "builtin",
              "external",
              "internal",
              "parent",
              "sibling",
              "index"
            ],
            "pathGroups": [
              {
                "pattern": "components/**",
                "group": "internal",
                "position": "before"
              },
              {
                "pattern": "assets/**",
                "group": "internal",
                "position": "after"
              }
            ],
            "pathGroupsExcludedImportTypes": ["internal"],
            "alphabetize": {
              "order": "asc",
              "caseInsensitive": true
            },
            "newlines-between": "always"
          }
        ]
      }
    }
  ]
}
